# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Database URL. For local SQLite: sqlite:///cooperative.db
# For Render PostgreSQL: postgresql://user:password@host/dbname
DATABASE_URL=sqlite:///cooperative.db

# Optional: Admin Telegram User ID for restricted commands
ADMIN_ID=your_telegram_user_id

# Timezone (e.g., Asia/Kolkata, UTC)
TIMEZONE=Asia/Kolkata

# Monthly expected contribution from each member
MONTHLY_CONTRIBUTION_AMOUNT=500

# Google Sheet ID for auto-sync
